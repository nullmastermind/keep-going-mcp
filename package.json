{
  "name": "auggie-prompt-enhancer-mcp",
  "version": "0.0.2",
  "description": "A Model Context Protocol server that enhances user prompts using Augment's context engine",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "module",
  "bin": {
    "prompt-enhancer-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "assistant",
    "prompt-enhancer",
    "augment",
    "tool"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nullmastermind/prompt-enhancer-mcp.git"
  },
  "homepage": "https://github.com/nullmastermind/prompt-enhancer-mcp",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "bun build index.ts --outdir=dist --target=node --format=esm",
    "prepublishOnly": "npm run build",
    "lint": "bunx biome check --write",
    "typecheck": "bunx tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && npm run start",
    "dev": "bun run index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@augmentcode/auggie-sdk": "^0.1.10",
    "@modelcontextprotocol/sdk": "^1.18.1",
    "zod": "^3.23.8"
  }
}
